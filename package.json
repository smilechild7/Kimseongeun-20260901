{
  "name": "levit-problem-solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,client --prefix-colors magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "crawl:products": "node crawler/cli/crawl-products.js",
    "crawl:reviews": "node crawler/cli/crawl-reviews.js",
    "crawl:catalog": "node crawler/cli/crawl-catalog.js",
    "enrich": "node --env-file-if-exists=.env scripts/enrichProducts.js",
    "enrich:sample": "node --env-file-if-exists=.env scripts/enrichProducts.js --product-ids=graychic:11284,graychic:11135,graychic:15143,ifemme:29474,ifemme:31358",
    "enrich:phase9-sample": "node --env-file-if-exists=.env scripts/enrichProducts.js --product-ids=graychic:12349,ifemme:33080,ririnco:29377,annanplus:17537,chicline:8721,hotping:36555,commonunique:28849,dodry:38539,maybins:45573,baddiary:29803 --output=data/enriched/phase9-sample.preview",
    "enrich:phase9-full": "node --env-file-if-exists=.env scripts/enrichProducts.js --missing-only --seed=data/enriched/phase9-sample.preview",
    "db:build": "node scripts/buildDatabase.js",
    "db:inspect": "node scripts/inspectDatabase.js",
    "db:migrate": "node scripts/runMigrations.js",
    "catalog:validate": "node scripts/validateCatalogAssets.js",
    "search:inspect": "node scripts/inspectSearch.js",
    "agent:inspect": "node --env-file-if-exists=.env scripts/inspectAgent.js",
    "eval:live": "node scripts/runFinalEval.js",
    "eval:naturalness": "node --env-file-if-exists=.env scripts/runNaturalnessEval.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
