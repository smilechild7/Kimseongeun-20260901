{
  "name": "levit-problem-solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,client --prefix-colors magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "crawl:products": "node crawler/cli/crawl-products.js",
    "crawl:reviews": "node crawler/cli/crawl-reviews.js",
    "enrich": "node --env-file-if-exists=.env scripts/enrichProducts.js",
    "enrich:sample": "node --env-file-if-exists=.env scripts/enrichProducts.js --product-ids=graychic:11284,graychic:11135,graychic:15143,ifemme:29474,ifemme:31358",
    "db:build": "node scripts/buildDatabase.js",
    "db:inspect": "node scripts/inspectDatabase.js",
    "db:migrate": "node scripts/runMigrations.js",
    "search:inspect": "node scripts/inspectSearch.js",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
